<?xml version="1.0" encoding="utf-8"?>
<!--
  go2servicemode icon.

  Mark: a glass capsule (the app's own UI motif) holding three ascending signal
  bars; the tallest bar uses the accent colour. Reads as "menu" and "signal" at
  the same time, and stays legible down to 48 px.

  Everything is vector: no bitmaps to keep in sync, and the adaptive icon can be
  masked by the launcher without cropping the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- background: deep glass, slightly lit from the top left -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF1E2C45" />
                <item android:offset="0.55" android:color="#FF141D30" />
                <item android:offset="1" android:color="#FF0B111B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft bloom behind the mark, so the capsule sits on light rather than black -->
    <path android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:offset="0" android:color="#332F6BFF" />
                <item android:offset="1" android:color="#002F6BFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
