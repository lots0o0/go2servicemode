# Release signing material. Copy to keystore.properties (git-ignored) and fill in.
# Never commit the filled-in file, the .jks, or the passwords.
#
# storeFile may be absolute or relative to the repository root.
storeFile=../release.jks
storePassword=CHANGE_ME
keyAlias=go2servicemode
keyPassword=CHANGE_ME

# The same values can be supplied through environment variables instead, which is
# what CI does: GO2SM_KEYSTORE, GO2SM_STORE_PASSWORD, GO2SM_KEY_ALIAS,
# GO2SM_KEY_PASSWORD.
